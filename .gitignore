# --- secrets (never commit) ---
local.setting.json
.dlt/secrets.toml

# --- DuckLake: parquet data files (catalog metadata lives in Postgres) ---
lake_pg/
*.vmbak
# --- published output parquet / json ---
publish/

# --- Dagster instance home (storage/history/logs/artifacts) ---
home/
# ...but keep the instance config (concurrency etc.) under version control
!home/dagster.yaml

# --- dbt build artifacts (regenerated on run) ---
dbt/target/
dbt/logs/
dbt/dbt.duckdb
dbt/dbt.duckdb.wal
dbt/.user.yml

# --- logs & python caches ---
*.log
__pycache__/
*.pyc
.dlt/
.venv/
